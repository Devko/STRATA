# The repo is edited on Windows but built in WSL. Shell scripts and Makefiles must keep LF
# endings or they break with "bad interpreter" / "missing separator" under bash and make.
* text=auto eol=lf

*.sh      text eol=lf
Makefile  text eol=lf
*.mk      text eol=lf

*.cpp     text eol=lf
*.hpp     text eol=lf
*.c       text eol=lf
*.h       text eol=lf
*.py      text eol=lf
*.md      text eol=lf

# Binary: never translate.
*.ena     binary
*.bin     binary
*.wav     binary
*.png     binary

# Lists that parallel PRs append to at the same place: merge both sides' lines instead of
# stopping on a conflict (the threads bring main into their branch before a merge). Union keeps
# every line, so a line both sides edited comes out twice: read the merged hunk. For the checklist,
# tools/check_rules.sh fails when two items took the same number.
CHANGELOG.md            merge=union
docs/UNIT_CHECKLIST.md  merge=union
